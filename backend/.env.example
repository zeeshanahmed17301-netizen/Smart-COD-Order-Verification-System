# Django
DJANGO_SECRET_KEY=replace-with-strong-secret-key

# Optional production host settings
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=False

# Production database (PostgreSQL)
DB_NAME=riskguard
DB_USER=riskguard
DB_PASSWORD=replace-with-db-password
DB_HOST=localhost
DB_PORT=5432

# Shopify
SHOPIFY_API_VERSION=2025-10
SHOPIFY_SYNC_TIMEOUT=20

# Address validation: internal_heuristic (offline) | opencage | google
ADDRESS_VALIDATION_PROVIDER=internal_heuristic
OPENCAGE_API_KEY=replace-with-opencage-key
GOOGLE_ADDRESS_VALIDATION_API_KEY=replace-with-google-key
ADDRESS_VALIDATION_TIMEOUT_SECONDS=5
ADDRESS_VALIDATION_FRESHNESS_DAYS=30

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK_URL=https://your-public-webhook-url.example.com/api/chatbot/webhooks/twilio/
TWILIO_VALIDATE_SIGNATURES=True
CHATBOT_ALLOW_MERCHANT_SENDERS=False

# Optional LLM fallback for ambiguous intent replies
CHATBOT_ENABLE_LLM_FALLBACK=False
CHATBOT_LLM_API_URL=https://api.openai.com/v1/chat/completions
CHATBOT_LLM_API_KEY=replace-with-llm-api-key
CHATBOT_LLM_MODEL=gpt-4o-mini
CHATBOT_LLM_CONFIDENCE_THRESHOLD=0.75
CHATBOT_LLM_TIMEOUT_SECONDS=8

# Chatbot automation cadence
CHATBOT_NUDGE_INTERVAL_MINUTES=30
CHATBOT_MAX_NUDGES=2

# Email — used for password-reset links.
# Leave EMAIL_BACKEND unset to print emails to the console (development default).
# For real delivery via Gmail: enable 2-Step Verification, create an App Password
# at https://myaccount.google.com/apppasswords, and use it below (no spaces).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=replace-with-gmail-app-password
DEFAULT_FROM_EMAIL=Risk-Guard <your-email@gmail.com>
# Base URL of the frontend, used to build links inside emails
FRONTEND_URL=http://localhost:5173
